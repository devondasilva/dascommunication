# ═══════════════════════════════════════════════════════════════
#  DAS COM — variables d'environnement
#  Copiez ce fichier en .env.local et complétez-le.
#  Sans DATABASE_URL, l'application tourne en MODE DÉMO :
#  base PostgreSQL embarquée (PGlite), comptes et données fictifs.
# ═══════════════════════════════════════════════════════════════

# ─── Base de données PostgreSQL (production) ───────────────────
# Neon, Supabase, Railway… (sur Vercel : intégration Neon en 1 clic)
# DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# ─── Authentification (Auth.js) ────────────────────────────────
# Clé secrète, 32 caractères minimum : npx auth secret
AUTH_SECRET=""

# Connexion Google des clients
# Console Google Cloud → API et services → Identifiants → ID client OAuth (application Web)
# URI de redirection autorisée : https://VOTRE-DOMAINE/api/auth/callback/google
#                       en local : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Premier super-administrateur ──────────────────────────────
# Créé automatiquement au premier `npm run db:setup` (ou au démarrage en mode démo)
ADMIN_EMAIL="dascom2004@gmail.com"
ADMIN_PASSWORD=""

# ─── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="DAS Communication"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Devise ISO 4217 : XOF (F CFA), EUR, USD…
NEXT_PUBLIC_DEVISE="XOF"
NEXT_PUBLIC_CONTACT_EMAIL="dascom2004@gmail.com"
NEXT_PUBLIC_CONTACT_TELEPHONE=""
